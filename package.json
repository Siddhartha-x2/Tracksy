{
  "name": "tracksy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env server/start-dev.js",
    "start": "node --env-file-if-exists=.env server/start.js",
    "start:api": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build --configLoader native"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.7"
  }
}
