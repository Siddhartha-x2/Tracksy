{
  "name": "tracksy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/local.mjs setup",
    "dev": "node scripts/local.mjs dev",
    "start": "node scripts/local.mjs start",
    "build": "node scripts/local.mjs build",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "node scripts/local.mjs test",
    "test:integration": "node --test tests/workflow.test.mjs",
    "migrate:legacy": "node scripts/migrate-legacy.mjs",
    "backup": "node scripts/local.mjs backup",
    "package": "node scripts/package-source.mjs"
  }
}
