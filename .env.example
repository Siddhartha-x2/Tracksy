PORT=4000
SPRING_PROFILES_ACTIVE=production
APP_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://localhost:5173,http://127.0.0.1:5173
# Use true behind HTTPS. false is for a loopback-only local preview.
COOKIE_SECURE=false
# Docker database passwords. The Windows launcher generates its own local credentials.
DB_ADMIN_PASSWORD=
DB_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_FACULTY_NAME=Faculty guide
BOOTSTRAP_FACULTY_EMAIL=
BOOTSTRAP_FACULTY_PASSWORD=
# Optional verified GitHub identity linking. No GitHub source pushes are performed.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/integrations/github/callback
# Optional email delivery; inactive until configured and each user verifies/opts in.
PUBLIC_APP_URL=http://localhost:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
